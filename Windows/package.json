{
  "name": "codex-wallpaper-windows",
  "productName": "Codex Wallpaper",
  "version": "0.1.1",
  "description": "Local wallpaper and glass style companion for Codex on Windows",
  "author": "huangxian1",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "setup": "node node_modules/electron/install.js",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package": "electron-packager . CodexWallpaper --platform=win32 --arch=x64 --out=dist --overwrite --asar --ignore=\"^/(dist[^/]*|tests|test-output|\\.test-user-data)($|/)\""
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.9.1"
  }
}
